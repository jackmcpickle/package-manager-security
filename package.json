{
  "name": "@jackmcpickle/pmsec",
  "version": "0.1.0",
  "description": "Audit package-manager security settings and advisories across monorepos and folders of projects. Supports npm, pnpm, yarn, bun, and uv.",
  "keywords": [
    "audit",
    "bun",
    "cli",
    "npm",
    "pnpm",
    "security",
    "supply-chain",
    "uv",
    "yarn"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmcpickle/package-manager-security.git"
  },
  "bin": {
    "pmsec": "./dist/pmsec.js"
  },
  "files": [
    "dist/pmsec.js",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "coverage:check": "bun scripts/check-coverage.ts",
    "coverage:write": "bun scripts/check-coverage.ts --write",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/main.ts --target=bun --banner '#!/usr/bin/env bun' --outfile dist/pmsec.js",
    "build:binary": "bun build ./src/main.ts --compile --outfile dist/pmsec",
    "prepublishOnly": "bun test && bun run build",
    "check": "ultracite check",
    "check:type-aware": "ultracite check --type-aware",
    "fix": "ultracite fix",
    "lint": "ultracite check"
  },
  "dependencies": {
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "eslint-plugin-crap": "0.1.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "ultracite": "7.10.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
